{
  "name": "chess-vault",
  "private": true,
  "workspaces": [
    "Backend",
    "Frontend",
    "Shared"
  ],
  "scripts": {
    "dev:backend": "bun --cwd Backend dev",
    "dev:frontend": "bun --cwd Frontend dev",
    "build:shared": "npm run build --workspace=@chess-vault/shared",
    "build:backend": "npm run build --workspace=chess-vault-backend",
    "build:frontend": "npm run build --workspace=chess-vault-frontend",
    "deploy:backend": "npm ci && npm run build:shared && npm run build:backend",
    "deploy:frontend": "npm ci && npm run build:shared && npm run build:frontend"
  }
}
